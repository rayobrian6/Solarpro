# .npmrc — local + Vercel install behavior
# Added 2026-07-31 to unblock the next-15-migration build on james-dev.
#
# legacy-peer-deps=true is required because:
#   - chore/next-15-migration (commit ad577d1b, merged into james-dev) bumped
#     react to 19.2.0 + next to 15.5.15.
#   - lucide-react@^0.344.0 (the pinned version) declares peer
#     react@"^16.5.1 || ^17.0.0 || ^18.0.0" — does NOT include React 19.
#   - npm v7+ refuses to install on peer-dep mismatch (ERESOLVE), so the
#     Vercel build fails on `npm install` before `next build` even runs.
#
# This is the QUICK fix. The PROPER fix is to upgrade lucide-react to a 1.x
# version that supports React 19 (latest: 1.28.0) — but that is a major
# version bump with ~50 icon renames (Loader2 → Loader, ExternalLink →
# ArrowUpRight, etc.) that needs its own dedicated migration branch.
#
# Track the proper migration as a follow-up — do NOT bundle it with the
# build-unblock fix.
legacy-peer-deps=true
