# ============================================================
# SolarPro Environment Variables — Template
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git — it contains secrets.
# See DEVELOPMENT.md for where to get each value.
# ============================================================

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Get from https://console.neon.tech → your project → Connection string (pooled)
DATABASE_URL=YOUR_NEON_DATABASE_URL_HERE

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
#
# CRITICAL — Vercel multi-environment setup:
#   Vercel → Project → Settings → Environment Variables → Add JWT_SECRET
#   Check ALL THREE boxes: Production ✓  Preview ✓  Development ✓
#   Use the SAME value for all three environments.
#   If Production and Preview have different secrets, a token signed at login
#   (Production) cannot be verified at /api/auth/me (Preview) → AUTH_COOKIE_MISSING.
#   This is the most common cause of "login works but next page fails" after deploy.
#
# Diagnosis: visit /api/debug/auth after deploy — authSecretFingerprint must match
# the fingerprint logged by [AUTH_SECRET_FINGERPRINT] in the login function logs.
JWT_SECRET=YOUR_JWT_SECRET_HERE

# ── Dev Auth Bypass (PREVIEW / LOCAL DEV ONLY — never activate in production) ──
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  IMPORTANT: NODE_ENV IS NOT RELIABLE ON VERCEL                         │
# │  Vercel sets NODE_ENV=production for ALL deployment types:              │
# │    - Production deployments  (VERCEL_ENV=production)                   │
# │    - Preview deployments     (VERCEL_ENV=preview)   ← development here │
# │    - Vercel CLI dev          (VERCEL_ENV=development)                   │
# │                                                                         │
# │  The auth bypass uses VERCEL_ENV as the production gate, not NODE_ENV.  │
# │  VERCEL_ENV=production → bypass ALWAYS blocked (hard-coded).           │
# │  VERCEL_ENV=preview + DEV_AUTH_BYPASS=true → bypass active.            │
# └─────────────────────────────────────────────────────────────────────────┘
#
# Problem solved:
#   Every preview deployment is a fresh serverless instance. If JWT_SECRET is
#   not set in Vercel Settings for the Preview environment, verifyToken() returns
#   null for every request and you get stuck in a login loop:
#     AUTH_COOKIE_MISSING → AUTH_MIDDLEWARE_BLOCKED → 401 /api/auth/me → redirect
#
# Solution: set DEV_AUTH_BYPASS=true in Vercel Settings (Preview scope only).
#   The bypass returns a fixed super_admin dev user — no JWT cookie needed.
#
# ── Vercel Dashboard Setup (one-time, per project) ───────────────────────
#
#   Step 1: Ensure JWT_SECRET is set for ALL environments:
#     Vercel → Project → Settings → Environment Variables
#     Add JWT_SECRET → set value → check Production ✓ Preview ✓ Development ✓
#     Generate a strong secret:
#       node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
#     CRITICAL: The SAME secret value must be used across all environments.
#     If Production and Preview have different values, tokens signed in one
#     environment cannot be verified in the other.
#
#   Step 2 (optional — bypass instead of fixing JWT_SECRET for preview):
#     Add DEV_AUTH_BYPASS=true → check Preview ✓ Development ✓
#     Leave Production UNCHECKED — bypass must never activate in production.
#
# ── Local dev (.env.local — never commit) ────────────────────────────────
#
# DEV_AUTH_BYPASS=true
# DEV_AUTH_USER_ID=dev-user-001        # optional — default: dev-user-bypass-001
# DEV_AUTH_USER_EMAIL=dev@localhost    # optional — default: dev@localhost
# DEV_AUTH_USER_NAME=Dev User          # optional — default: Dev User (Bypass)
#
# ── Safety guards — bypass is blocked when: ──────────────────────────────
#   VERCEL_ENV=production (Vercel production deployment — hard-coded block)
#   DEV_AUTH_BYPASS not set or not 'true'
#
# ── Verification ─────────────────────────────────────────────────────────
#   After deploying, visit /api/debug/auth to see:
#     devAuthAllowed: true/false
#     devAuthBypassed: true/false
#     jwtSecretSet: true/false
#     authSecretFingerprint: len=XX_head=XXXX_...
#   Search Vercel function logs for [DEV_AUTH_ACTIVE] to confirm bypass is on.

# ── App URL — CRITICAL for password reset links, Stripe callbacks, share URLs ─
#
# Set NEXT_PUBLIC_APP_URL to your PRODUCTION domain in Vercel environment vars.
# Without this, reset links and share URLs will fall back to VERCEL_URL which
# is an ephemeral preview deployment URL and will NOT match your production domain.
#
# In Vercel dashboard → Settings → Environment Variables (Production scope):
#   NEXT_PUBLIC_APP_URL = https://solarpro-v31.vercel.app
#
# This single variable is used by:
#   - lib/env.ts getBaseUrl()         → all password reset email links
#   - lib/stripe.ts                   → Stripe checkout/portal return URLs
#   - lib/billOcrEngine.ts            → internal API call base URL
#   - app/api/proposals/[id]/share/   → proposal share link generation
#
# Local dev:
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── File Storage / Vercel Blob ───────────────────────────────────────────────
# Required in Vercel Production for durable homeowner utility bill attachments.
# Without this token, /free-solar-estimate still captures the intake and bill
# metadata, but Admin Intake Feed cannot show Open Bill / Download Bill links
# because no retrievable file URL exists.
# Get from Vercel → Project → Storage → Blob → Connect Store / Environment Variables.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token_here

# ── Google Maps / Geocoding ───────────────────────────────────────────────────
# Get from https://console.cloud.google.com → APIs → Maps JavaScript API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# ── Cesium Ion (3D terrain maps) ──────────────────────────────────────────────
# Get from https://cesium.com/ion/tokens
NEXT_PUBLIC_CESIUM_ION_TOKEN=YOUR_CESIUM_ION_TOKEN_HERE

# ── NREL PVWatts (solar production estimates) ─────────────────────────────────
# Get from https://developer.nrel.gov/signup/ — or use DEMO_KEY for dev
NREL_API_KEY=DEMO_KEY

# ── Stripe (billing/subscriptions) ───────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys — use sk_test_* for dev
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY

# Stripe Price IDs — get from https://dashboard.stripe.com/products
# Create one product per plan, copy the Price ID (price_xxxxx) for each.
STRIPE_PRICE_STARTER=price_YOUR_STARTER_PRICE_ID
STRIPE_PRICE_PROFESSIONAL=price_YOUR_PROFESSIONAL_PRICE_ID
STRIPE_PRICE_CONTRACTOR=price_YOUR_CONTRACTOR_PRICE_ID

# ── Anthropic (Claude 3.5 Sonnet — primary bill extraction engine) ─────────────────────
# Get from https://console.anthropic.com — Account → API Keys
# PRIMARY AI engine for utility bill parsing (text + multimodal image parsing).
# Without this key, bill parsing falls back to GPT-4o-mini (text) or Tesseract OCR (images).
# Recommended for best extraction accuracy — especially bar chart usage history and
# non-standard bill layouts that confuse traditional OCR.
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# ── OpenAI (GPT-4o-mini — bill extraction fallback + AI assistant) ────────────────────
# Get from https://platform.openai.com/api-keys — optional for local dev
# Used as fallback when ANTHROPIC_API_KEY is absent or Claude extraction fails.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# ── Mapbox (map tiles) ────────────────────────────────────────────────────────
# Get from https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=YOUR_MAPBOX_TOKEN_HERE

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Get from https://resend.com → API Keys
# Required for password reset emails in production.
# Sender domain: mail.solarpro.app (add Resend DNS records in Gandi.net)
# From address:  noreply@mail.solarpro.app
RESEND_API_KEY=re_YOUR_RESEND_API_KEY_HERE


# -- Observability / Error Monitoring (Sentry) --------------------------------
# When set, ALL unhandled errors (server + browser) are shipped to Sentry.
# Without this, errors still appear in Vercel function logs (console.error).
#
# Setup:
#   1. Create project at https://sentry.io -> New Project -> Next.js
#   2. Copy the DSN (starts with https://...)
#   3. Add to Vercel Dashboard -> Project -> Settings -> Environment Variables:
#        SENTRY_DSN             = https://xxx@oNNN.ingest.sentry.io/NNN
#        NEXT_PUBLIC_SENTRY_DSN = same value (for browser-side capture)
#   4. In Sentry: Alerts -> New Alert -> set severity=error -> email/Slack notify
#
# Verify: GET /api/system/health -> checks.monitoring.ok should be true
#
# NOTE: No @sentry/nextjs package install required. Uses lightweight fetch API.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# -- Survey Partner Integration ----------------------------------------------
# Partner (survey app) base URL for survey handoff and payload fetch.
# Production: https://site-survey-api-bpyz.onrender.com
PARTNER_BASE_URL=https://site-survey-api-bpyz.onrender.com

# Static Bearer token for GET /api/surveys/{id} requests to the survey app.
# Must match PARTNER_API_KEY (or SOLARPRO_API_KEY) set on the survey app backend.
# In production this is the SOLARPRO_API_KEY JWT from the survey app .env.
PARTNER_API_BEARER_TOKEN=YOUR_PARTNER_API_BEARER_TOKEN_HERE

# Shared HS256 secret for minting handoff JWTs (/new-survey?token=...).
# Must be at least 32 characters.
SOLARPRO_HANDOFF_SECRET=YOUR_SOLARPRO_HANDOFF_SECRET_HERE

# TTL in seconds for handoff JWTs (default: 600 = 10 minutes).
HANDOFF_TOKEN_TTL_SECONDS=600

# Comma-separated list of allowed redirect_uri PREFIXES for /api/auth/authorize.
#
# IMPORTANT: If this env var is set (even partially), it REPLACES the built-in
# defaults entirely. You must include ALL schemes you need.
#
# Built-in defaults (used when this var is empty/unset):
#   sitesurvey://   — production custom scheme (site survey app)
#   exp://          — Expo Go development client (any host, e.g. exp://u.expo.dev/...)
#   com.underthesun. — production bundle-id scheme
#
# REQUIRED in Vercel → Project → Settings → Environment Variables:
#   AUTHORIZE_ALLOWED_REDIRECTS=sitesurvey://,exp://,com.underthesun.
#
# If you only set sitesurvey:// here, Expo Go SSO will fail with:
#   {"error":"redirect_uri is not in the allowlist","allowedPrefixes":["sitesurvey://"]}
AUTHORIZE_ALLOWED_REDIRECTS=sitesurvey://,exp://,com.underthesun.

# HMAC-SHA256 secret for verifying incoming survey webhooks from partner.
SURVEY_WEBHOOK_SECRET=YOUR_SURVEY_WEBHOOK_SECRET_HERE

# Default user ID that owns survey-origin projects created by ingest pipeline.
SURVEY_INGEST_DEFAULT_USER_ID=YOUR_USER_UUID_HERE

# Set to true to accept survey webhooks and return 202 before ingest runs.
WEBHOOK_PRE_INGEST_ACCEPT_202=true

# ── Database Migrations ───────────────────────────────────────────────────────
# Protects POST /api/db/migrate from unauthorized execution.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In Vercel: set the same value and pass it as { "secret": "..." } in the request body.
MIGRATE_SECRET=YOUR_MIGRATE_SECRET_HERE

# ── Opportunity Intake & Acquisition Infrastructure ──────────────────────────
# API key for POST /api/intake (server-to-server ingestion).
INTAKE_API_KEY=YOUR_INTAKE_API_KEY_HERE

# Meta (Facebook) Lead Ads webhook
META_APP_SECRET=YOUR_META_APP_SECRET_HERE
META_WEBHOOK_VERIFY_TOKEN=YOUR_META_VERIFY_TOKEN_HERE

# Google Ads webhook key (X-Google-Key header value)
GOOGLE_WEBHOOK_KEY=YOUR_GOOGLE_WEBHOOK_KEY_HERE

# Generic partner webhook fallback secret
WEBHOOK_SECRET_GENERIC=YOUR_GENERIC_WEBHOOK_SECRET_HERE

# ATTOM property data API key (propertyEnricher.ts — primary provider)
ATTOM_API_KEY=YOUR_ATTOM_API_KEY_HERE

# OpenEI utility rates API key (utilityEnricher.ts — secondary provider)
OPENEI_API_KEY=YOUR_OPENEI_API_KEY_HERE

# ── Photo Vision Auto-Labeling ──────────────────────────────────────────────
# Minimum confidence (0-1) for auto-assigning photo labels from YOLO/OCR candidates.
# When a photo vision job completes, object_detection candidates above this
# threshold are automatically mapped to evidence categories (main_service_panel,
# meter, roof_plane, overview, etc.) and written to site_survey_files.label.
# Lower values = more labels but more false positives; higher = fewer but more accurate.
# Default: 0.70
PHOTO_VISION_AUTO_LABEL_MIN_CONFIDENCE=0.55

# Roof edge count threshold for roof_plane classification
# Photos with >= this many roof_edge_candidate entries are classified as roof_plane
# Roof edge heuristic: counts are AGGREGATED per unique filename (not per file_id row).
# Roof photos: 27-80 edges per filename. Non-roof: 0-10. Threshold 20 cleanly separates.
ROOF_EDGE_MIN_COUNT_THRESHOLD=20

# Candidate diversity thresholds for overview classification
# Requires 5+ distinct candidate types AND no single type > 45% of total.
# This identifies wide-angle photos with diverse visual features.
OVERVIEW_MIN_CANDIDATE_TYPES=5
OVERVIEW_MAX_DOMINANT_RATIO=0.45

# ── SAM 2 Segmentation Service ──────────────────────────────────────────
# URL of the SAM 2 Python service deployed on Render.
# When set, Pipeline B uses SAM 2 for segmentation (primary) with Canny fallback.
# When empty/missing, Pipeline B uses Canny edge detection only.
# Deploy: https://dashboard.render.com/web/srv-d8dj4mv7f7vs73ca0gtg
SAM2_SERVICE_URL=https://sam2-segmentation.onrender.com

# ── Geometry Reconstruction Worker Auth ─────────────────────────────────
# Shared secret for the /api/site-surveys/[id]/geometry-reconstruction/execute endpoint.
# Required in Vercel env vars — the endpoint returns 401 if this is not set.
# NOTE: The Render worker does NOT use this — it polls DB directly.
# Only needed if you want to manually trigger pipeline execution via the execute endpoint.
INTERNAL_WORKER_AUTH_TOKEN=YOUR_INTERNAL_WORKER_AUTH_TOKEN_HERE

# ── Vercel Cron Secret ──────────────────────────────────────────────────
# Required to secure Vercel cron job endpoints (/api/cron/*).
# Vercel automatically sends this as Authorization: Bearer <CRON_SECRET>.
# Generate with: openssl rand -hex 32
# Add in Vercel Dashboard → Settings → Environment Variables.
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Render API key for deployment management and service monitoring.
# Get from: https://dashboard.render.com/u/settings#api-keys
RENDER_API_KEY=rnd_vORy1PEkvohnoQBoYKTgI2TjHaRz
